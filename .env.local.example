# ─── Sanity CMS ─────────────────────────────────────────────────────────────
# Create a project at https://sanity.io and paste the values below.

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Read/Write token from Sanity → Project → API → Tokens
# Required for server-side data fetching and draft previews
SANITY_API_TOKEN=your_sanity_token_here

# ─── Chatbot Integration ─────────────────────────────────────────────────────
# Option A: Embed via iframe URL (Tidio, Crisp, Freshdesk, custom bot)
NEXT_PUBLIC_CHATBOT_IFRAME_URL=

# Option B: Load via script tag (Drift, Intercom, Tidio script)
NEXT_PUBLIC_CHATBOT_SCRIPT_URL=

# ─── Virtual Tour ─────────────────────────────────────────────────────────────
# Embed URL for 360° virtual campus tour
NEXT_PUBLIC_VIRTUAL_TOUR_URL=

# ─── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.myuni.edu.in
