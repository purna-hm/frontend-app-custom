# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js build output ────────────────────────────────────────────────────
.next/
out/
build/
.turbo/

# ─── Testing ─────────────────────────────────────────────────────────────────
coverage/

# ─── Environment files ───────────────────────────────────────────────────────
# Never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# DO commit the example template so other devs know what vars are needed
!.env.local.example

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Misc ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ─── Debug logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/tmp/

# ─── Claude Code / AI agent config (not for production) ──────────────────────
AGENTS.md
CLAUDE.md
.claude/

# ─── Old scaffold (myuni-portal was the initial create-next-app folder) ──────
myuni-portal/
